{
	"luci-app-wg-obfuscator": {
		"description": "Grant access to WireGuard Obfuscator configuration",
		"read": {
			"uci": [ "wg-obfuscator" ],
			"file": {
				"/var/etc/wg-obfuscator.conf": [ "read" ]
			},
			"ubus": {
				"service": [ "list" ]
			}
		},
		"write": {
			"uci": [ "wg-obfuscator" ],
			"ubus": {
				"service": [ "event" ]
			}
		}
	}
}
